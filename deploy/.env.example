# Modèle de deploy/.env (versionné, SANS secret). `./setup.sh` crée .env à partir de ce fichier
# en générant les mots de passe PostgreSQL et le secret JWT. Le vrai .env n'est JAMAIS versionné.

# --- Bases de données (une par service) ---
USER_DB_PASSWORD=CHANGE_ME
ALUMNI_STUDENT_COMPANY_DB_PASSWORD=CHANGE_ME
JOB_OFFER_DB_PASSWORD=CHANGE_ME
ANALYTICS_MATCHING_DB_PASSWORD=CHANGE_ME
NOTIFICATION_MESSAGING_DB_PASSWORD=CHANGE_ME

# --- JWT (identique pour les 5 services, Base64, 32 octets minimum) ---
JWT_SECRET=CHANGE_ME
JWT_ISSUER=alumni-uasz-user

# --- Emails (confirmation de compte, réinitialisation du mot de passe) ---
# Par défaut : Mailpit, emails lisibles sur http://localhost:8025 (aucun compte nécessaire).
# Brevo : MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, MAIL_USERNAME = identifiant SMTP Brevo,
#         MAIL_PASSWORD = clé SMTP Brevo, MAIL_FROM = expéditeur validé dans Brevo.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@alumni-uasz.sn
# Validité du lien de confirmation (30m, 24h, 2d...)
EMAIL_CONFIRMATION_TTL=24h

# --- Frontend ---
# URL publique (liens des emails + CORS des services)
FRONTEND_URL=http://localhost:4200
# Source du build : dépôt Git (branche après #) ou chemin local, ex. ../../../web/Alumni-UASZ-frontend
FRONTEND_CONTEXT=https://github.com/UASZ-2024-2025/Alumni-UASZ-frontend.git#develop
