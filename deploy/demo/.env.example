# Modèle de /opt/alumni/demo.env (écrit par scripts/bootstrap.sh, jamais versionné).

# --- Répartition ---------------------------------------------------------------
# vm-a | vm-b | vm-a,vm-b (un seul serveur)
COMPOSE_PROFILES=vm-a,vm-b
# Nom de domaine public (certificat Let's Encrypt automatique)
DEMO_DOMAIN=alumni-demo.203.0.113.10.sslip.io

# --- Réseau entre machines (laisser les valeurs par défaut sur un seul serveur) ---
# IP sur laquelle PostgreSQL (vm-a) et les services de vm-b sont publiés
PRIVATE_BIND=127.0.0.1
# Hôte PostgreSQL vu par les services (IP privée de vm-a depuis vm-b)
DB_HOST=db
# Services de vm-b vus par Caddy (IP privée de vm-b:port depuis vm-a)
UPSTREAM_JOB_OFFER=job-offer-service:8083
UPSTREAM_ANALYTICS=analytics-matching-service:8084
UPSTREAM_NOTIFICATION=notification-messaging-service:8085

# --- Secrets (générés aléatoirement par bootstrap.sh) ------------------------------
JWT_SECRET=
PG_SUPERUSER_PASSWORD=
USER_DB_PASSWORD=
ALUMNI_STUDENT_COMPANY_DB_PASSWORD=
JOB_OFFER_DB_PASSWORD=
ANALYTICS_MATCHING_DB_PASSWORD=
NOTIFICATION_MESSAGING_DB_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
# Accès à l'interface Mailpit (https://<domaine>/mailpit/) : utilisateur:motdepasse
MAILPIT_UI_AUTH=

# --- Optionnel ---------------------------------------------------------------------
# Vrais e-mails (Brevo, etc.) à la place de Mailpit
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# Copie des sauvegardes vers S3 (rôle IAM de la machine, aucune clé)
# BACKUP_BUCKET=
