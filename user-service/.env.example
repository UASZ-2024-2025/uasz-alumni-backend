# Modèle du fichier .env (versionné, SANS secret, valeurs FICTIVES).
# `make setup` crée .env à partir de ce fichier : mot de passe PostgreSQL généré,
# JWT_SECRET généré (user-service) ou COPIÉ depuis ../user-service/.env (autres services).
# Le vrai .env n'est JAMAIS versionné.
# Toutes les clés sont OBLIGATOIRES (l'appli n'a aucune valeur par défaut).
# Une valeur CHANGE_ME est refusée au démarrage (make run / make up).

# --- Base de données ---
POSTGRES_DB=user_db
POSTGRES_USER=alumni_user
POSTGRES_PASSWORD=CHANGE_ME
# Un port différent par service pour pouvoir tous les lancer en même temps
DB_PORT=5432

# --- JWT ---
# Doit être IDENTIQUE dans tous les services (Base64, 32 octets minimum).
JWT_SECRET=CHANGE_ME
JWT_ISSUER=alumni-uasz-user

# --- Serveur / CORS / API ---
SERVER_PORT=8081
# none en dev ; native derrière un ingress de confiance
FORWARD_HEADERS_STRATEGY=none
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Contrats : serveur local = http://localhost:8081/v1 ; en K8s le ConfigMap fixe /user-service/v1
API_PREFIX=/v1

# --- Emails (confirmation de compte) ---
# Dev : Mailpit (conteneur lancé par make db / make run), interface web http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
# Laisser vide pour Mailpit ; à renseigner avec un vrai serveur SMTP en production
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@alumni-uasz.sn
# URL du frontend utilisée dans les liens des emails
FRONTEND_URL=http://localhost:4200
# Validité du lien de confirmation (30m, 24h, 2d...)
EMAIL_CONFIRMATION_TTL=24h

# --- Authentification ---
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_TTL=1h
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION=15m
# Premier ADMINISTRATEUR (créé au démarrage s'il n'y en a aucun d'actif).
# make setup génère le mot de passe ; il refuse CHANGE_ME.
BOOTSTRAP_ADMIN_EMAIL=admin@alumni-uasz.sn
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=Alumni UASZ
